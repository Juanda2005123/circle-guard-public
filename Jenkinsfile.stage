// ============================================================
// Jenkinsfile.stage — Pipeline de CI/CD para el entorno STAGE
// Rama objetivo : release/* o stage
// Namespace K8s : stage
// ============================================================

pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'circleguardacr.azurecr.io'
        NAMESPACE       = 'stage'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        KUBECONFIG      = '/var/jenkins_home/.kube/config_internal'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                echo "📥 Descargando código de la rama: ${env.BRANCH_NAME}"
                checkout scm
                sh 'chmod +x gradlew'
            }
        }

        stage('Build & Test') {
            steps {
                echo "🧪 Ejecutando suite de pruebas (unitarias + integración)..."
                sh './gradlew cleanTest'
                sh './gradlew test --no-daemon --continue'
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: '**/build/test-results/**/*.xml'
                    echo "📊 Resultados de pruebas publicados en Jenkins."
                }
                failure {
                    echo "❌ STAGE 2 FALLIDO: Las pruebas no pasaron. Abortando pipeline."
                }
            }
        }

        stage('Static Code Analysis (SonarQube)') {
            steps {
                script {
                    echo "🔍 Iniciando análisis estático de código con SonarQube..."
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        sh "./gradlew sonar -Dsonar.projectKey=circleguard -Dsonar.host.url=http://host.docker.internal:9000 -Dsonar.login=\${SONAR_TOKEN}"
                    }
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    echo "🐳 Construyendo y publicando imágenes Docker para los 6 microservicios..."

                    def services = [
                        'circleguard-gateway-service',
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-notification-service',
                        'circleguard-promotion-service'
                    ]

                    withCredentials([usernamePassword(credentialsId: 'acr-credentials', usernameVariable: 'ACR_USER', passwordVariable: 'ACR_PASS')]) {
                        sh 'echo "$ACR_PASS" | docker login ${DOCKER_REGISTRY} -u "$ACR_USER" --password-stdin'

                        services.each { service ->
                            def imageName = "${env.DOCKER_REGISTRY}/${service}:${env.IMAGE_TAG}"
                            def imageLatest = "${env.DOCKER_REGISTRY}/${service}:latest"

                            echo "  → Building: ${imageName}"
                            sh """
                                docker build \
                                    -t ${imageName} \
                                    -t ${imageLatest} \
                                    -f services/${service}/Dockerfile \
                                    .
                            """

                            echo "  → Pushing: ${imageName}"
                            sh "docker push ${imageName}"
                            sh "docker push ${imageLatest}"
                        }
                    }

                    echo "✅ Las 6 imágenes fueron construidas y publicadas en ${env.DOCKER_REGISTRY}."
                }
            }
        }

        stage('Container Security Scan (Trivy)') {
            steps {
                script {
                    echo "🛡️ Iniciando escaneo de seguridad de contenedores con Trivy..."
                    def scanServices = [
                        'circleguard-gateway-service',
                        'circleguard-auth-service'
                    ]
                    scanServices.each { service ->
                        def imageName = "${env.DOCKER_REGISTRY}/${service}:${env.IMAGE_TAG}"
                        echo "  → Escaneando imagen: ${imageName}"
                        sh "trivy image --severity HIGH,CRITICAL --no-progress ${imageName} || true"
                    }
                }
            }
        }

        stage('Prepare K8s Config') {
            steps {
                script {
                    echo "🔧 Configurando credenciales de Kubernetes (AKS)..."
                    sh 'mkdir -p /var/jenkins_home/.kube'
                    // Copiamos el kubeconfig del cluster AKS mapeado desde el host
                    sh 'cp /tmp/kube_host/config ${KUBECONFIG}'
                    sh 'kubectl get nodes'
                }
            }
        }

        stage('Deploy Infra') {
            steps {
                script {
                    echo "🏗️  Desplegando infraestructura base en namespace '${env.NAMESPACE}'..."

                    sh 'kubectl apply -f k8s/namespaces.yml'

                    sh '''
                        for file in k8s/infrastructure/*.yml; do
                            echo "  → Aplicando: $file"
                            envsubst < "$file" | kubectl apply -f -
                        done
                    '''

                    echo "⏳ Esperando a que Postgres esté listo..."
                    sh """
                        kubectl rollout status deployment/postgres-deployment \
                            -n ${env.NAMESPACE} \
                            --timeout=600s
                    """
                    echo "✅ Infraestructura desplegada correctamente."
                }
            }
        }

        stage('Deploy Services') {
            steps {
                script {
                    echo "🚀 Desplegando los 6 microservicios en namespace '${env.NAMESPACE}'..."

                    sh '''
                        for file in k8s/templates/*.yml; do
                            echo "  → Aplicando: $file"
                            envsubst < "$file" | kubectl apply -f -
                        done
                    '''

                    def services = [
                        'gateway-service',
                        'identity-service',
                        'auth-service',
                        'form-service',
                        'notification-service',
                        'promotion-service'
                    ]

                    services.each { service ->
                        echo "  → Verificando rollout de ${service}..."
                        sh """
                            kubectl rollout status deployment/${service}-deployment \
                                -n ${env.NAMESPACE} \
                                --timeout=600s
                        """
                    }

                    echo "✅ Todos los microservicios desplegados y en estado Ready."
                }
            }
        }

        stage('E2E & Performance Tests') {
            steps {
                script {
                    echo "🧪 Ejecutando pruebas E2E (REST Assured), Rendimiento de Integración (Neo4j) y Carga (Locust)..."

                    // El gateway-service es NodePort dentro de AKS y no es accesible
                    // directamente desde el contenedor de Jenkins, así que abrimos
                    // un port-forward temporal hacia el Service.
                    sh 'kubectl port-forward -n ${NAMESPACE} svc/gateway-service 30087:8087 --address 0.0.0.0 > /tmp/port-forward.log 2>&1 &'
                    sh 'sleep 5'

                    sh '''
                        echo "Ejecutando pruebas con REST Assured..."
                        ./gradlew test --tests "*E2E*" -Dgateway.url=http://localhost:30087 -DrunE2E=true || echo "Advertencia: Algunas pruebas E2E fallaron."
                    '''
                    sh '''
                        echo "Ejecutando pruebas de rendimiento de integración (Neo4j/Testcontainers)..."
                        ./gradlew :services:circleguard-promotion-service:test --tests "*PromotionPerformanceTest*" -DrunPerformance=true || echo "Advertencia: Pruebas de rendimiento de integración finalizadas con errores."
                    '''
                    sh '''
                        echo "Ejecutando pruebas de carga con Locust..."
                        docker run --rm --network host -v \$(pwd)/performance-tests:/mnt/locust locustio/locust -f /mnt/locust/locustfile.py --headless -u 50 -r 10 --run-time 1m --host http://localhost:30087 || echo "Advertencia: Pruebas de rendimiento finalizadas con errores."
                    '''

                    sh 'pkill -f "kubectl port-forward" || true'
                }
            }
        }
    }

    post {
        success {
            echo """
            ============================================
            ✅ PIPELINE STAGE — EXITOSO
            --------------------------------------------
            Namespace  : ${env.NAMESPACE}
            Image Tag  : ${env.IMAGE_TAG}
            Branch     : ${env.BRANCH_NAME}
            Gateway URL: http://localhost:30087
            ============================================
            """
        }
        failure {
            echo """
            ============================================
            ❌ PIPELINE STAGE — FALLIDO
            --------------------------------------------
            Build  : #${env.BUILD_NUMBER}
            Branch : ${env.BRANCH_NAME}
            Revisa los logs del stage marcado en rojo.
            ============================================
            """
        }
        always {
            echo "🔍 Logs del namespace ${env.NAMESPACE}:"
            sh "kubectl get all -n ${env.NAMESPACE} 2>/dev/null || echo 'Namespace no disponible'"
        }
    }
}
